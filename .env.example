# Copy to .env. Never commit real credentials.
APP_ENV=development
DATABASE_PATH=./data/conversations.sqlite3
DEVICE_AUTH_TOKEN=
MAX_AUDIO_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=45
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
LIVE_PROVIDER_ORDER=openai_realtime,gemini_live
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_SESSION_TIMEOUT_SECONDS=20
LIVE_SILENCE_DURATION_MS=800
LIVE_VAD_THRESHOLD=0.5
LIVE_PREFIX_PADDING_MS=300
SYSTEM_PROMPT=You are a friendly, concise voice assistant inside a small interactive robot. Speak naturally and keep answers brief.
