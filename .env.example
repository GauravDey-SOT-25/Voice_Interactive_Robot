# Copy to .env. Never commit real credentials.
APP_ENV=development
DATABASE_PATH=./data/conversations.sqlite3
DEVICE_AUTH_TOKEN=
MAX_AUDIO_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=45
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
SYSTEM_PROMPT=You are a friendly, concise voice assistant inside a small interactive robot. Speak naturally and keep answers brief.
